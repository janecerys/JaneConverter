{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JaneConverter Desktop",
  "version": "2.2.0",
  "identifier": "com.janecerys.janeconverter.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "JaneConverter Desktop",
        "width": 1420,
        "height": 900,
        "minWidth": 1080,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' http://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "../../assets/icon.ico",
      "../../assets/icon.png"
    ]
  }
}
