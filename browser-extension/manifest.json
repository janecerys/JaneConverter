{
  "manifest_version": 3,
  "name": "JaneConverter Browser Bridge",
  "version": "2.0.0",
  "description": "Connects one explicitly approved browser session to JaneConverter over localhost for the current media source.",
  "action": {
    "default_title": "Connect to JaneConverter",
    "default_popup": "popup.html"
  },
  "permissions": [
    "cookies",
    "tabs"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
