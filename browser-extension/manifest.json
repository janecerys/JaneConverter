{
  "manifest_version": 3,
  "name": "JaneConverter Browser Bridge",
  "version": "1.0.2",
  "description": "Connects one explicitly approved browser session to JaneConverter over localhost for the current media source.",
  "action": {
    "default_title": "Connect to JaneConverter",
    "default_popup": "popup.html"
  },
  "permissions": [
    "cookies",
    "tabs"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "*://500px.com/*",
    "*://*.500px.com/*",
    "*://archive.org/*",
    "*://*.archive.org/*",
    "*://bandcamp.com/*",
    "*://*.bandcamp.com/*",
    "*://bilibili.com/*",
    "*://*.bilibili.com/*",
    "*://dailymotion.com/*",
    "*://*.dailymotion.com/*",
    "*://discord.com/*",
    "*://*.discord.com/*",
    "*://facebook.com/*",
    "*://*.facebook.com/*",
    "*://fb.watch/*",
    "*://flickr.com/*",
    "*://*.flickr.com/*",
    "*://giphy.com/*",
    "*://*.giphy.com/*",
    "*://imgur.com/*",
    "*://*.imgur.com/*",
    "*://instagram.com/*",
    "*://*.instagram.com/*",
    "*://kick.com/*",
    "*://*.kick.com/*",
    "*://linkedin.com/*",
    "*://*.linkedin.com/*",
    "*://mixcloud.com/*",
    "*://*.mixcloud.com/*",
    "*://music.apple.com/*",
    "*://pinterest.com/*",
    "*://*.pinterest.com/*",
    "*://reddit.com/*",
    "*://*.reddit.com/*",
    "*://rumble.com/*",
    "*://*.rumble.com/*",
    "*://snapchat.com/*",
    "*://*.snapchat.com/*",
    "*://soundcloud.com/*",
    "*://*.soundcloud.com/*",
    "*://spotify.com/*",
    "*://*.spotify.com/*",
    "*://streamable.com/*",
    "*://*.streamable.com/*",
    "*://telegram.org/*",
    "*://*.telegram.org/*",
    "*://threads.net/*",
    "*://*.threads.net/*",
    "*://tiktok.com/*",
    "*://*.tiktok.com/*",
    "*://tumblr.com/*",
    "*://*.tumblr.com/*",
    "*://twitch.tv/*",
    "*://*.twitch.tv/*",
    "*://twitter.com/*",
    "*://*.twitter.com/*",
    "*://vimeo.com/*",
    "*://*.vimeo.com/*",
    "*://vk.com/*",
    "*://*.vk.com/*",
    "*://whatsapp.com/*",
    "*://*.whatsapp.com/*",
    "*://x.com/*",
    "*://*.x.com/*",
    "*://youtu.be/*",
    "*://youtube.com/*",
    "*://*.youtube.com/*"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
